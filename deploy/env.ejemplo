# Plantilla de variables para docker compose (UPMarket).
#
# Uso recomendado: ejecuta deploy/generar-env.sh, que crea .env con secretos
# aleatorios y mantiene JWT_SECRET y JWT_SECRET_BASE64 apuntando a los mismos
# bytes (si no coinciden, el dominio rechaza todos los tokens).
#
# Si copias esta plantilla a mano, cambia TODOS los valores. Los de abajo son
# válidos (sirven para arrancar) pero públicos: cualquiera puede firmar tokens.
DB_ROOT_PASSWORD=0123456789abcdef0123456789abcdef
DB_PASSWORD=0123456789abcdef0123456789abcdef
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZg==
ADMIN_PASSWORD=0123456789abcdef01234567
# Opcional: ruta local del repositorio de AuthCore en vez de clonarlo de GitHub.
# AUTHCORE_CONTEXT=../Auth-Core-UpMarket
