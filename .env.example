# Copia a .env (o mejor: ./deploy/generar-env.sh lo crea con secretos aleatorios).
DB_ROOT_PASSWORD=cambiar
DB_PASSWORD=cambiar
# Clave compartida con AuthCore (mínimo 32 caracteres).
JWT_SECRET=cambiar-por-una-cadena-aleatoria-larga-de-64-caracteres
# La MISMA clave en Base64:  printf '%s' "$JWT_SECRET" | base64 -w0
JWT_SECRET_BASE64=cambiar
# AUTHCORE_CONTEXT=../auth-core-upmarket
